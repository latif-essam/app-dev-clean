#!/usr/bin/env bash
#
# devclean — global dev-cache cleaner. Resolves the project root by walking up
# from cwd, then cleans that project's caches. Extensible via apps/*.sh modules.
#
# Usage:
#   devclean                 interactive menu (must be inside a known project)
#   devclean ios js          run named targets (resolves root first)
#   devclean local-all       all LOCAL targets for the detected app type
#   devclean nuclear         local-all + globals + reinstall
#   devclean gradle-global   a global cache target (allowed anywhere, confirmed)
#   devclean --root          print resolved project root + app type, then exit
#   devclean --help          this help
#
set -euo pipefail

# --- resolve install home (bin/ lives under DEVCLEAN_HOME) ---
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  _d="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$_d/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
DEVCLEAN_HOME="${DEVCLEAN_HOME:-$(dirname "$SCRIPT_DIR")}"

# --- load library + all app modules ---
# shellcheck source=/dev/null
source "$DEVCLEAN_HOME/lib/core.sh"
# shellcheck source=/dev/null
source "$DEVCLEAN_HOME/lib/detect.sh"
for _f in "$DEVCLEAN_HOME"/apps/*.sh; do
  # shellcheck source=/dev/null
  [ -f "$_f" ] && source "$_f"
done

usage() {
  cat <<EOF
devclean — dev-cache cleaner (resolves project root, cleans safely)

  devclean                interactive menu (inside a known project)
  devclean <target>...    run named targets (e.g. ios js metro)
  devclean local-all      all LOCAL targets for the detected app type
  devclean nuclear        local-all + global caches + reinstall
  devclean gradle-global  global cache target (allowed anywhere; confirmed)
  devclean --root         print resolved project root + app type
  devclean --help         this help

Supported app types: ${APP_TYPES[*]}
Global targets (project-agnostic): gradle-global xcode-dd pods-cache
EOF
}

# require_root: resolve PROJECT_ROOT/APP_TYPE from cwd or refuse.
require_root() {
  if ! resolve_root "$PWD"; then
    err "not inside a recognized project (looked for: ${APP_TYPES[*]})."
    printf "  refusing local cleanup so nothing gets deleted in the wrong place.\n" >&2
    printf "  cd into a project, or run a global target (e.g. gradle-global).\n" >&2
    exit 1
  fi
}

# confirm_globals TARGET... : prompt before touching shared caches / full nuke.
confirm_globals() {
  local t needs=0
  for t in "$@"; do
    if is_global_target "$t" || [ "$t" = "nuclear" ]; then needs=1; fi
  done
  [ "$needs" -eq 0 ] && return 0
  printf "${c_red}About to clean shared/global caches:${c_reset} %s\n" "$*"
  read -r -p "  These affect ALL projects. Proceed? [y/N] " yn
  [[ "$yn" =~ ^[Yy]$ ]] || { echo "aborted"; exit 0; }
}

# run_targets TARGET... : dispatch each to global or app run fn, then post-hook.
run_targets() {
  local targets=("$@") t idx run_fn post_fn
  for t in "${targets[@]}"; do
    if is_global_target "$t"; then
      run_global "$t"
    else
      idx="$(app_index_for "$APP_TYPE")"
      run_fn="${APP_RUN_FN[$idx]}"
      "$run_fn" "$t"
    fi
  done
  # optional per-app post-run hook (reinstall prompts) if app known
  if [ -n "$APP_TYPE" ]; then
    idx="$(app_index_for "$APP_TYPE")"
    post_fn="${APP_POST_FN[$idx]}"
    [ -n "$post_fn" ] && "$post_fn" "${targets[@]}"
  fi
  return 0
}

main() {
  # flags
  case "${1:-}" in
    --help|-h) usage; exit 0 ;;
    --root)
      if resolve_root "$PWD"; then
        printf "${c_green}%s${c_reset}\n" "$PROJECT_ROOT"
        printf "app type: %s\n" "$APP_TYPE"
      else
        err "not a project (no recognized root up-tree from $PWD)"
        exit 1
      fi
      exit 0 ;;
  esac

  if [ "$#" -eq 0 ]; then
    # interactive menu — requires being inside a project
    require_root
    cd "$PROJECT_ROOT"
    step "project: $PROJECT_ROOT ($APP_TYPE)"
    local idx menu_fn
    idx="$(app_index_for "$APP_TYPE")"
    menu_fn="${APP_MENU_FN[$idx]}"
    MENU_ROWS=()
    while IFS= read -r line; do MENU_ROWS+=("$line"); done < <("$menu_fn")
    menu
    [ "${#SELECTED_TARGETS[@]}" -eq 0 ] && { warn "nothing selected"; exit 0; }
    confirm_globals "${SELECTED_TARGETS[@]}"
    run_targets "${SELECTED_TARGETS[@]}"
  else
    local args=("$@") has_local=0 t
    for t in "${args[@]}"; do
      is_global_target "$t" || has_local=1
    done
    if [ "$has_local" -eq 1 ]; then
      require_root
      cd "$PROJECT_ROOT"
      step "project: $PROJECT_ROOT ($APP_TYPE)"
    else
      # global-only: try to resolve for nicer context, but don't require it
      resolve_root "$PWD" || true
    fi
    confirm_globals "${args[@]}"
    run_targets "${args[@]}"
  fi

  printf "\n${c_green}Done.${c_reset}\n"
}

main "$@"
